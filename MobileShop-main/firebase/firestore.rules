rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.role == 'OWNER'; }
    function hasBranch(b) {
      return signedIn() && (isOwner() || b in request.auth.token.branch_ids);
    }

    // Financial/stock source-of-truth collections are server-write only.
    match /sales/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /saleItems/{id} { allow read: if signedIn(); allow write: if false; }
    match /payments/{id} { allow read: if signedIn(); allow write: if false; }
    match /purchases/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /ledgerEntries/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /wallets/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /stockMovements/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /auditLogs/{id} { allow read: if isOwner(); allow write: if false; }
    match /returns/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /expenses/{id} { allow read: if hasBranch(resource.data.branchId); allow write: if false; }
    match /installments/{id} { allow read: if signedIn(); allow write: if false; }
    match /installmentPayments/{id} { allow read: if signedIn(); allow write: if false; }

    // Reference/master data may be server-mediated as well; default deny.
    match /{document=**} { allow read, write: if false; }
  }
}
